{
  "name": "node-exec-mcp",
  "version": "0.1.0",
  "description": "MCP server for executing commands on remote machines via OpenClaw node exec",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "node-exec-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Andreas Spannagel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandysp/node-exec-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/pandysp/node-exec-mcp/issues"
  },
  "homepage": "https://github.com/pandysp/node-exec-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "node-exec",
    "remote-execution",
    "openclaw"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.0.0",
    "vitest": "^3.2.0"
  }
}
